{
  "name": "deckcraft-desktop",
  "productName": "DeckCraft",
  "version": "0.2.0",
  "private": true,
  "description": "DeckCraft by Golden Maple: desktop shell around the standalone build (dist/deckcraft).",
  "author": "Golden Maple Landscaping",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test appServer.test.cjs",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "ca.goldenmaplelandscaping.deckcraft",
    "productName": "DeckCraft",
    "directories": {"output": "release", "buildResources": "build"},
    "files": ["main.cjs", "preload.cjs", "appServer.cjs", "package.json", "build/icon.png"],
    "extraResources": [{"from": "../../dist/deckcraft", "to": "deckcraft"}],
    "asar": true,
    "win": {"target": "nsis", "icon": "build/icon.png"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "artifactName": "DeckCraft Setup ${version}.${ext}"}
  }
}
