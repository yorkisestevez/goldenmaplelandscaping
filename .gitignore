node_modules/
build/
dist/
.react-router/
coverage/
.DS_Store
*.log
.env*
!.env.example
.netlify/

# Editor scratch (Claude Code per-machine state)
.claude/

# Gemini-era backups from the 2026-07-28 Claude CLI migration
scripts/blog-publisher/*.bak-gemini-*

# Client documents must never reach this PUBLIC repo. A signed client invoice
# (real name, address, price) was sitting loose in the repo root on 2026-08-01,
# one `git add -A` away from being published. Keep working copies here if
# convenient, but they stay untracked.
*.pdf
!public/**/*.pdf
!docs/**/*.pdf
!guides/**/*.pdf
/.hermes/

# CodeGraph / editor tool caches (per-machine, do not ship)
.codegraph/
.cursor/

# Meta photo harvest masters (re-downloadable by id via scripts/photos/harvest-meta-photos.mjs); only the index is tracked
sources/meta/*.jpg

# Regenerable review sheets (node scripts/photos/harvest-meta-photos.mjs --sheets); keep the markdown + shortlist.json
docs/portfolio/meta-sheet-*.jpg
docs/portfolio/shortlist-*.jpg
